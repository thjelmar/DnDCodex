# D&D Codex voice bot — copy to .env and fill in. Never commit the real .env.

# Discord bot token: Developer Portal -> your application -> Bot -> Reset Token.
# This is a SECRET.
DISCORD_BOT_TOKEN=

# The server and voice channel to watch. In Discord, right-click the voice
# channel -> Copy Link, which is https://discord.com/channels/<GUILD>/<CHANNEL>.
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=

# Supabase project — the SAME values as the app's VITE_SUPABASE_URL and
# VITE_SUPABASE_ANON_KEY (the anon key is fine; the bot only broadcasts).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Case-insensitive substring that identifies the recording bot in the channel.
# When a bot member whose name matches is present, the app shows "Recording".
RECORDER_NAME_MATCH=craig
