# D&D Codex Raspberry Pi services — copy to .env and fill in. Never commit the real .env.
# Both services read this file (see README.md).

# Discord webhook for alerts. This is a SECRET: anyone with the URL can post to the channel.
# Channel settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL.
ALERT_WEBHOOK_URL=

# --- Uptime check (uptime/check.mjs) ----------------------------------------

# The app to check.
CHECK_APP_URL=https://dndcodex.pages.dev

# The same values as bot/.env and the app. The anon key is public by design.
# Leave both empty to skip the Supabase check.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Comma-separated systemd services that must be running.
CHECK_SERVICES=codexbot

# Alert when the SD card is this percent full.
DISK_ALERT_PERCENT=90

# Optional: a dead-man's-switch URL (for example from healthchecks.io). The check pings it
# every run, so the service can tell you when the whole Pi stops. Leave empty to skip.
HEARTBEAT_URL=

# --- Database backup (backup/db-backup.sh) ----------------------------------

# Supabase dashboard -> Connect -> Session pooler. Use the pooler host: the direct
# connection is IPv6-only, and a home network often has no IPv6.
BACKUP_DB_HOST=
BACKUP_DB_PORT=5432
BACKUP_DB_NAME=postgres
# For the pooler the user is <role>.<project-ref>, for example codex_backup.abcdefghijkl.
BACKUP_DB_USER=
BACKUP_DB_PASSWORD=

# How many nightly dumps to keep.
BACKUP_KEEP=7

# Where dumps go. The default is /var/lib/codex-pi/db on the SD card.
# To use a USB stick later, mount it and set this to a folder on it.
# BACKUP_DIR=/mnt/usb/codex-backups
