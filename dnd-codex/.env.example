# Copy to .env and fill in from your Supabase project (Settings → API keys).
# Use the PUBLISHABLE key (sb_publishable_…) — the modern client key that
# replaces the legacy "anon" key. It's safe in the browser; real security comes
# from Row-Level Security policies. Never commit your real .env.
# (The variable name stays *_ANON_KEY for now; only the value is the new key.)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key
