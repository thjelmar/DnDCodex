# Copy to .env and fill in from your Supabase project (Settings → API).
# The anon key is a publishable client key — safe in the browser; real security
# comes from Row-Level Security policies. Never commit your real .env.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
